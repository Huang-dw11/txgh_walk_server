<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.walk.mapper.WalkAwardMapper">

    <select id="selectAwardsByActivity" resultType="org.dromara.walk.domain.vo.WalkAwardVo">
        select * from walk_award
        where del_flag = '0'
          and activity_id = #{activityId}
        order by sort_order
    </select>

</mapper>
